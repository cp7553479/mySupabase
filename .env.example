# Public Supabase connection values. These may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only database connection. Never prefix server-only values with NEXT_PUBLIC_.
DATABASE_URL=

# Server-only Supabase admin key. Required only for administrator email invitations.
SUPABASE_SECRET_KEY=
